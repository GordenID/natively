{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "framework": null,
  "functions": {
    "api/auth/*.js": {
      "maxDuration": 10
    },
    "api/mcp.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp?sub=prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?sub=prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/mcp?sub=asm"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/mcp?sub=asm"
    },
    {
      "source": "/api/mcp/:sub(authorize|token|register)",
      "destination": "/api/mcp?sub=:sub"
    }
  ]
}
